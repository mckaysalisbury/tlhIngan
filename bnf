<verb_prefix> ::= <declarative_prefix> | <imperative_prefix>
# This bnl expression doesn't consider the unspecified object cases grammatically, but they're the same prefixes, so it's effectively just a linguistic agreement case, which is stated as uncovered elsewhere.

<declarative_prefix> ::= <no_object_declarative_prefix> | <object_declarative_prefix>
<imperative_prefix> ::= <no_object_imperative_prefix> | <object_imperative_prefix>

<no_object_declarative_prefix> ::= "jI" | "bI" | | "ma" | "Su"
